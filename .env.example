# Copia este archivo como .env y completa los valores. Nunca subas el .env
# al repositorio ni compartas los valores reales.
# Genera la clave con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Django (obligatoria en producción; sin ella la app no arranca con DEBUG=false)
DJANGO_SECRET_KEY=
# false en producción. En desarrollo, 'true'.
DJANGO_DEBUG=false
# Dominios separados por comas, por ejemplo: 127.0.0.1,localhost
DJANGO_ALLOWED_HOSTS=

# API REST de MikroTik (corre en el puerto 8000; la web corre en el 8001)
MIKROTIK_API_URL=http://127.0.0.1:8000/api
MIKROTIK_API_TIMEOUT=5
MIKROTIK_API_TOKEN=<redacted>
MIKROTIK_API_USERNAME=
MIKROTIK_API_PASSWORD=<redacted>
